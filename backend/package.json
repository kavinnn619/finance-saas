{
    "name": "finance-saas-backend",                                                                                          
    "version": "1.0.0",
    "private": true,
    "scripts": {
      "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
      "build": "npx prisma generate && tsc && npx prisma migrate deploy",
      "start": "node dist/index.js",
      "prisma:generate": "prisma generate",
      "prisma:migrate": "prisma migrate dev",
      "prisma:seed": "ts-node prisma/seed.ts",
      "test": "jest",
      "test:watch": "jest --watch"
    },
    "dependencies": {
      "express": "^4.18.2",
      "helmet": "^7.1.0",
      "cors": "^2.8.5",
      "jsonwebtoken": "^9.0.2",
      "bcrypt": "^5.1.1",
      "zod": "^3.22.4",
      "xss": "^1.0.14",
      "express-rate-limit": "^7.1.5",
      "rate-limit-redis": "^4.1.1",
      "redis": "^4.6.12",
      "@prisma/client": "^5.7.0",
      "winston": "^3.11.0",
      "dotenv": "^16.3.1"
    },
    "devDependencies": {
      "@types/express": "^4.17.21",
      "@types/cors": "^2.8.17",
      "@types/jsonwebtoken": "^9.0.5",
      "@types/bcrypt": "^5.0.2",
      "typescript": "^5.3.3",
      "ts-node": "^10.9.2",
      "ts-node-dev": "^2.0.0",
      "prisma": "^5.7.0",
      "jest": "^29.7.0",
      "@types/jest": "^29.5.11",
      "supertest": "^6.3.3"
    }
