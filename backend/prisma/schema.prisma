 generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
  }

  enum UserRole {
    ADMIN
    ACCOUNTANT
    USER
  }

  enum AccountType {
    CHECKING
    SAVINGS
    INVESTMENT
    CREDIT_CARD
    LOAN
  }

  enum TransactionType {
    DEBIT
    CREDIT
  }

  enum ReportType {
    MONTHLY_SUMMARY
    TAX_REPORT
    CASH_FLOW
    BALANCE_SHEET
  }

  enum ReportStatus {
    PENDING
    COMPLETED
    FAILED
  }

  model User {
    id            String    @id @default(uuid())
    email         String    @unique @db.VarChar(255)
    passwordHash  String    @map("password_hash") @db.VarChar(255)
    firstName     String    @map("first_name") @db.VarChar(100)
    lastName      String    @map("last_name") @db.VarChar(100)
    role          UserRole  @default(USER)
    isActive      Boolean   @map("is_active") @default(true)
    lastLogin     DateTime? @map("last_login")
    createdAt     DateTime  @map("created_at") @default(now())
    updatedAt     DateTime  @map("updated_at") @updatedAt

    sessions      Session[]
    accounts      Account[]
    transactions  Transaction[]
    reports       Report[]
    auditLogs     AuditLog[] @relation("AuditLogUser")
    rateLimits    RateLimit[]

    @@index([email])
    @@index([role])
    @@map("users")
  }

  model Session {
    id           String   @id @default(uuid())
    userId       String   @map("user_id")
    tokenHash    String   @map("token_hash") @db.VarChar(255)
    userAgent    String?  @map("user_agent") @db.Text
    ipAddress    String?  @map("ip_address") @db.VarChar(45)
    expiresAt    DateTime @map("expires_at")
    isRevoked    Boolean  @map("is_revoked") @default(false)
    createdAt    DateTime @map("created_at") @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([tokenHash])
    @@index([expiresAt])
    @@map("sessions")
  }

  model Account {
    id            String      @id @default(uuid())
    userId        String      @map("user_id")
    accountName   String      @map("account_name") @db.VarChar(255)
    accountType   AccountType @map("account_type")
    encryptedAccountNumber String? @map("encrypted_account_number") @db.Text
    balance       Decimal     @default(0.00) @db.Decimal(15, 2)
    currency      String      @default("USD") @db.Char(3)
    isActive      Boolean     @map("is_active") @default(true)
    lastSynced    DateTime?   @map("last_synced")
    createdAt     DateTime    @map("created_at") @default(now())
    updatedAt     DateTime    @map("updated_at") @updatedAt

    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    transactions Transaction[]

    @@check(balance >= -1000000000000.00 && balance <= 1000000000000.00)
    @@index([userId])
    @@index([accountType])
    @@map("accounts")
  }

  model Category {
    id          String   @id @default(uuid())
    name        String   @db.VarChar(100)
    type        TransactionType
    isSystem    Boolean  @map("is_system") @default(false)
    userId      String?  @map("user_id")
    createdAt   DateTime @map("created_at") @default(now())

    transactions Transaction[]
    user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([name, userId])
    @@index([type])
    @@map("categories")
  }

  model Transaction {
    id              String        @id @default(uuid())
    accountId       String        @map("account_id")
    userId          String        @map("user_id")
    categoryId      String?       @map("category_id")
    amount          Decimal       @db.Decimal(15, 2)
    transactionType TransactionType @map("transaction_type")
    description     String?       @db.VarChar(500)
    transactionDate DateTime      @map("transaction_date")
    referenceNumber String?      @map("reference_number") @db.VarChar(255)
    isReconciled    Boolean       @map("is_reconciled") @default(false)
    createdAt       DateTime      @map("created_at") @default(now())
    updatedAt       DateTime      @map("updated_at") @updatedAt

    account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

    @@check(amount > 0)
    @@index([userId])
    @@index([accountId])
    @@index([transactionDate])
    @@index([categoryId])
    @@index([isReconciled])
    @@map("transactions")
  }

  model Report {
    id          String      @id @default(uuid())
    userId      String      @map("user_id")
    reportType  ReportType  @map("report_type")
    parameters  Json
    status      ReportStatus @default(PENDING)
    fileUrl     String?     @map("file_url") @db.VarChar(500)
    generatedAt DateTime?   @map("generated_at")
    createdAt   DateTime    @map("created_at") @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([reportType])
    @@index([status])
    @@map("reports")
  }

  model RateLimit {
    id         String   @id @default(uuid())
    identifier String
    endpoint   String   @db.VarChar(255)
    requestCount Int    @map("request_count") @default(1)
    windowStart DateTime @map("window_start")
    expiresAt  DateTime @map("expires_at")

    @@index([identifier, endpoint])
    @@index([expiresAt])
    @@map("rate_limits")
  }

  model AuditLog {
    id          String   @id @default(uuid())
    userId      String?  @map("user_id")
    action      String   @db.VarChar(50)
    entityType  String   @map("entity_type") @db.VarChar(50)
    entityId    String   @map("entity_id")
    oldValues   Json?    @map("old_values")
    newValues   Json?    @map("new_values")
    ipAddress   String?  @map("ip_address") @db.VarChar(45)
    userAgent   String?  @map("user_agent") @db.Text
    createdAt   DateTime @map("created_at") @default(now())

    user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

    @@index([userId])
    @@index([entityType, entityId])
    @@index([createdAt])
    @@map("audit_logs")
  }
